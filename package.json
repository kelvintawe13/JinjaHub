{
  "name": "JinjaHub",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "Jinja Edu-Hub — an education and employment platform: courses, learning space, job listings, and employer applications.",
  "keywords": [
    "education",
    "e-learning",
    "courses",
    "jobs",
    "jinja",
    "react",
    "typescript",
    "vite",
    "tailwindcss"
  ],
  "author": "Jinja Edu-Hub Team",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "scripts": {
    "dev": "npx vite",
    "build": "npx vite build",
    "preview": "npx vite preview",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx"
  },
  "prettier": {
    "arrowParens": "avoid",
    "printWidth": 80,
    "singleQuote": true,
    "jsxSingleQuote": true,
    "trailingComma": "es5"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@emotion/react": "^11.13.3",
    "react-router-dom": "^6.26.2",
    "lucide-react": "0.522.0",
    "tailwind-merge": "latest",
    "framer-motion": "^11.5.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.18",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^5.54.0",
    "@typescript-eslint/parser": "^5.54.0",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.50.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.1",
    "typescript": "^5.5.4",
    "vite": "^5.2.0",
    "tailwindcss": "3.4.17",
    "autoprefixer": "latest",
    "postcss": "latest"
  }
